# --- Fireworks (COUNTED toward score — minimize!) ---
FIREWORKS_API_KEY=your_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# --- Local vLLM server on the AMD pod (FREE — zero Fireworks tokens) ---
LOCAL_BASE_URL=http://localhost:8000/v1
# Pod = Radeon PRO W7900-class: 48GB VRAM, RDNA3 (gfx1100). A 14B fits in fp16
# (~28GB) with room to spare; stretch goal is a 32B in 4-bit (AWQ) if ROCm/vLLM
# cooperate on gfx1100. Reliability first — stay on 14B fp16 if quant misbehaves.
LOCAL_MODEL=Qwen/Qwen2.5-14B-Instruct

# --- Router ---
CONF_THRESHOLD=0.75       # min self-consistency agreement to trust the local answer
SELF_CONSISTENCY_K=5      # local samples used to estimate confidence (all free)
